Problem: Implement push and pop operations on a stack and verify stack operations.


#include<stdio.h>

int main()
{
    int n,m,i,top=-1,stack[100];

    scanf("%d",&n);

    for(i=0;i<n;i++)
    {
        scanf("%d",&stack[++top]);
    }

    scanf("%d",&m);

    for(i=0;i<m;i++)
    {
        if(top>=0)
            top--;
    }

    for(i=top;i>=0;i--)
    {
        printf("%d ",stack[i]);
    }

    return 0;
}
